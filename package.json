{
  "name": "interview-ng-monorepo",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm --filter @interview-ng/web build && pnpm run build:server",
    "build:server": "cd apps/server && GOCACHE=\"$PWD/.gopath/gocache\" go build ./...",
    "typecheck": "pnpm --filter @interview-ng/web typecheck",
    "dev": "pnpm run dev:web",
    "dev:web": "pnpm --filter @interview-ng/web dev",
    "dev:server": "cd apps/server && GOCACHE=\"$PWD/.gopath/gocache\" go run ./cmd/server",
    "test": "pnpm run test:web && pnpm run test:server",
    "test:web": "pnpm --filter @interview-ng/web typecheck",
    "test:server": "cd apps/server && GOCACHE=\"$PWD/.gopath/gocache\" go test ./..."
  }
}
